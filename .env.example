# 生产/完整容器部署模板。复制为 .env 并填入真实值。
# 本地开发请改用 .env.local.example + docker-compose.dev.yml。
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

KAFKA_SERVERS=localhost:9092

# 通知邮件用的 SMTP 账号(QQ 邮箱为"授权码",不是登录密码);不配则邮件功能失败,其余功能不受影响
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-auth-code

# 生产环境请使用 HTTPS 域名
FRONTEND_BASE_URL=http://localhost:5173

# JWT HMAC-SHA256 密钥,至少 32 字节。可用: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# AI chatbot。API key 只写入本机/部署平台的 .env 或 Secret Manager,绝不提交。
OPENAI_API_KEY=replace-with-openai-project-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_MESSAGE_SIZE=16
ASSISTANT_TIME_ZONE=America/New_York

# 私有 Amazon S3 bucket。Bucket 需预先创建,应用不会自动建 bucket。
AWS_REGION=us-east-1
S3_BUCKET=replace-with-your-globally-unique-bucket-name
S3_PREFIX=audio

# 只供本机开发使用。EC2 部署请留空并使用实例 IAM Role。
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---- 以下仅 docker compose 部署时使用(本地裸跑脚本不读) ----
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=80
