{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RewardProjectAudioList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "audio/*"
          ]
        }
      }
    },
    {
      "Sid": "RewardProjectAudioObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET/audio/*"
    }
  ]
}
