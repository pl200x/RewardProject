# Copy to .env. The real file is ignored and must never be committed.
OPENAI_API_KEY=replace-with-a-new-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_MESSAGE_SIZE=16
JWT_SECRET=replace-with-the-same-32-byte-secret-used-by-Music-management

CHATBOT_PORT=8083
# Direct rollback only: SPRING_PROFILES_ACTIVE=direct
# MULTIREWARD_BASE_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=13306
DB_USERNAME=root
DB_PASSWORD=reward-local-password

# Spring Cloud discovery. Compose defaults to its private registry service.
# Host processes use http://localhost:8761/eureka/ unless explicitly overridden.
# EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# For multi-node deployment, advertise an address reachable by every caller:
# SERVICE_HOSTNAME=private-dns-name
# SERVICE_INSTANCE_ID=unique-instance-id
# EUREKA_PREFER_IP_ADDRESS=true
# SERVICE_IP_ADDRESS=10.0.0.10
