# Local-only configuration. Copy this file to .env.local.
# scripts/start-all.sh loads it after .env, so these values override any
# production/AWS settings while developing on this machine.

DB_HOST=127.0.0.1
DB_PORT=13306
DB_USERNAME=root
DB_PASSWORD=reward-local-password

REDIS_HOST=127.0.0.1
REDIS_PORT=16379
KAFKA_SERVERS=localhost:19092
KAFKA_PORT=19092

FRONTEND_BASE_URL=http://localhost:5173
JWT_SECRET=reward-project-local-jwt-secret-at-least-32-bytes

# Copy your local key into the git-ignored .env.local (or ai_chatbot/.env).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_MESSAGE_SIZE=16
ASSISTANT_TIME_ZONE=America/New_York

# Local MinIO S3. AWS accepts the same SDK calls in production; only these
# endpoint and credential values differ locally.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=rewardlocal
AWS_SECRET_ACCESS_KEY=reward-local-secret
AWS_SESSION_TOKEN=
S3_BUCKET=music
S3_PREFIX=audio
S3_ENDPOINT=http://127.0.0.1:19000
S3_PATH_STYLE_ACCESS=true
S3_LOCAL_PORT=19000
S3_CONSOLE_PORT=19001

# Email is optional during local agent development.
MAIL_USERNAME=
MAIL_PASSWORD=
